# ==============================================================================
# RetroTab Kiosk — Environment Variables Template
# Copy this file to `.env.local` for local dev or configure in Vercel Dashboard.
# NEVER commit real secrets or tokens to Git!
# ==============================================================================

# --- Authentication (REQUIRED) ---
ADMIN_USERNAME=admin
# Either a plaintext password (for quick start) or a bcrypt hash ($2a$/$2b$...)
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-hex-bytes

# --- Personalization & Commute ---
KIOSK_USER_NAME=Alex
KIOSK_CITY_NAME=San Francisco
KIOSK_TIMEZONE=America/Los_Angeles
COMMUTE_ORIGIN_NAME=Home Stop
COMMUTE_ORIGIN_LAT=37.7749
COMMUTE_ORIGIN_LON=-122.4194
COMMUTE_DEST_NAME=Downtown Office
COMMUTE_DEST_LAT=37.7897
COMMUTE_DEST_LON=-122.4014
COMMUTE_PREFERRED_LINE=Bus 38R
# Optional: Google Maps Directions API key for live transit ETAs (falls back to Open-Meteo + static estimates if unset)
GOOGLE_MAPS_API_KEY=

# --- AI Assistant & TTS (Gemini) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# --- Spotify Connect & Library (Optional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Google Gmail & Calendar OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Home Assistant Smart Home Bridge (Optional) ---
HA_URL=
HA_TOKEN=
HA_ROOM_LIGHT_ENTITY=light.room_light

# --- Supabase Persistence (Optional: for Tasks, PC Command Queue & Token Store) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local Windows Companion Agent (agent/laptop-agent.mjs) ---
# Set on the laptop running the companion agent:
RETROTAB_CLOUD_ORIGIN=https://your-retrotab-kiosk.vercel.app
RETROTAB_AGENT_HOST=127.0.0.1
RETROTAB_AGENT_PORT=8091
# Optional direct LAN camera snapshot or RTSP sources (RFC1918 private LAN only):
# RETROTAB_CAM_MAIN_URL=http://192.168.1.50/snapshot.jpg
# RETROTAB_CAM_DOOR_URL=rtsp://user:pass@192.168.1.51:554/stream2
